# Kopieer naar .env en pas aan:  cp .env.example .env

# Optioneel: de volledige URL waarmee je de site opent, bijvoorbeeld je reverse-proxy-adres. Leeg betekent dat de
# site het adres volgt waarop hij wordt geopend (ook http://<ip>:9888); vul hem in als de site maar op één adres
# bereikbaar hoort te zijn. Passkeys werken alleen via https (uitzondering: http://localhost); zonder https log je
# in het beheer in met een wachtwoord.
# ORIGIN=https://sintmaarten.flux76.app

# Domeinnaam voor de passkey (standaard: hostnaam uit ORIGIN, of anders van het adres in de browser).
# Alleen aanpassen als je weet waarom.
# RP_ID=sintmaarten.flux76.app

# Titel van de site
SITE_TITLE=Onze wijk

# Geheime code die nodig is om de ALLEREERSTE passkey of het eerste wachtwoord in te stellen (onboarding).
# Genereer bv. met: openssl rand -hex 12
SETUP_TOKEN=verander-mij-naar-iets-geheims

# Sleutel voor het ondertekenen van sessies (minstens 16 tekens).
# Genereer bv. met: openssl rand -hex 32
SESSION_SECRET=verander-mij-naar-een-lange-willekeurige-string

# Poort van de webserver (zowel in de container als op de NAS). Standaard 9888.
PORT=9888

# Welke versie draait: latest (stabiel, standaard), beta, of een versienummer om vast te zetten (bijv. v1.0.21).
# Een beta-stack krijgt een eigen DATA_PATH en een eigen poort/ORIGIN; de app toont dan een BETA-label.
DOORBELL_MAP_TAG=latest

# Map op de host waar de gegevens (huizen, passkeys, backups) komen te staan. Standaard ./data naast docker-compose.yml.
# Draai je de stack via een beheerder (Dockge, Portainer, Komodo) of op Unraid? Gebruik dan een absoluut pad,
# bijvoorbeeld /mnt/user/appdata/doorbell-map (de map wordt zo nodig aangemaakt).
# DATA_PATH=/mnt/user/appdata/doorbell-map

# Optioneel
# SESSION_HOURS=12
